# Show welcome banner (interactive shells only)
if [[ -o interactive ]]; then
  cat ~/.config/ghostty/welcome.txt
fi

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
#eval "$(starship init zsh)"

#fix the ssh issue
ssh() { TERM=xterm-256color command ssh "$@" }

export PATH="$PATH:$HOME/.dotnet/tools"
source ~/.zsh_aliases

#Docker CLI completions
fpath=(/Users/gyuszix/.docker/completions $fpath)
autoload -Uz compinit
(( ${+_comps[docker]} )) || compinit

# pipx
export PATH="$PATH:/Users/gyuszix/.local/bin"

# Secrets (gitignored, never committed)
[ -f ~/.dotfiles/zsh/secrets.zsh ] && source ~/.dotfiles/zsh/secrets.zsh

# Restore last working directory
if [ -f ~/.last_dir ]; then
  cd "$(cat ~/.last_dir)" 2>/dev/null
fi
chpwd() { pwd > ~/.last_dir }
